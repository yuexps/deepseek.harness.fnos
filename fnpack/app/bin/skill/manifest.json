{
  "name": "fnos",
  "version": "0.1.1",
  "description": "Use trim-cli to sign in to and manage fnOS devices, including files, photos, applications, Docker, downloads, logs, monitoring, networking, storage, users, and Baidu Netdisk. Use when the user mentions fnOS, 飞牛 OS, or a mainland China device. Excludes Media APIs and international-edition devices.",
  "entry": "SKILL.md",
  "bin": {
    "darwin-arm64": "bin/trim-cli-darwin-arm64",
    "darwin-x64": "bin/trim-cli-darwin-x64",
    "linux-arm64": "bin/trim-cli-linux-arm64",
    "linux-x64": "bin/trim-cli-linux-x64",
    "windows-arm64": "bin/trim-cli-windows-arm64.exe",
    "windows-x64": "bin/trim-cli-windows-x64.exe"
  },
  "reference": "reference/",
  "entriesDir": "entries/",
  "entries": [
    "entries/trim-app.md",
    "entries/trim-baidu-netdisk.md",
    "entries/trim-docker.md",
    "entries/trim-download.md",
    "entries/trim-file.md",
    "entries/trim-log.md",
    "entries/trim-monitor.md",
    "entries/trim-network.md",
    "entries/trim-photos.md",
    "entries/trim-shared.md",
    "entries/trim-storage.md",
    "entries/trim-system.md",
    "entries/trim-user.md"
  ],
  "capabilities": [
    "authentication",
    "file-management",
    "storage-management",
    "docker-management",
    "download-tasks",
    "system-monitoring",
    "network-management",
    "user-management",
    "photo-library",
    "baidu-netdisk"
  ]
}
